# Docker uploads the build context before it reads the Dockerfile, so anything
# not excluded here is sent to the builder. The working tree carries about 11 GB
# of training data and fat checkpoints that the image does not need.
.git
.venv
__pycache__
*.pyc
*.egg-info
.pytest_cache

data
out
monitor
tests
scripts
node_modules
# The Dockerfile runs this to fetch the face models at build time, so it has
# to survive the scripts/ exclusion above.
!scripts/get_face_models.py

# Only checkpoints/stable is copied by the Dockerfile.
checkpoints/*
!checkpoints/stable

.DS_Store
*.md
!web/README.md
# Served at /AGENTS.md by the app, so it must survive the *.md rule above.
# Without this the COPY in the Dockerfile silently has nothing to copy and the
# route 500s in production while working perfectly on a dev machine.
!AGENTS.md
